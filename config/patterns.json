{
  "_comment": "Built-in detectors. `group` names the capture that is the secret (default: whole match). `flags`: i m s. Keep this data, not code; add project-specific rules to ~/.claude/secret-guard/patterns.json.",
  "patterns": [
    {"id": "aws-access-key", "kind": "aws-access-key",
     "regex": "\\b((?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16})\\b"},
    {"id": "aws-secret-key", "kind": "aws-secret-key",
     "regex": "aws[_-]?(?:secret[_-]?)?(?:access[_-]?)?key(?:[_-]?id)?[\"']?\\s*[:=]\\s*[\"']?(?P<v>[A-Za-z0-9/+=]{40})\\b", "group": "v", "flags": "i"},
    {"id": "github-token", "kind": "github-token",
     "regex": "\\b(gh[pousr]_[A-Za-z0-9]{36,255})\\b"},
    {"id": "github-fine-grained", "kind": "github-token",
     "regex": "\\b(github_pat_[A-Za-z0-9_]{22,255})\\b"},
    {"id": "gitlab-pat", "kind": "gitlab-token",
     "regex": "\\b(glpat-[A-Za-z0-9_-]{20,})"},
    {"id": "gitlab-other", "kind": "gitlab-token",
     "regex": "\\b(gl(?:rt|dt|ptt|soat|agent|ft|oas|cs|imt)-[A-Za-z0-9_-]{20,})"},
    {"id": "gitlab-runner-reg", "kind": "gitlab-token",
     "regex": "\\b(GR1348941[A-Za-z0-9_-]{20})\\b"},
    {"id": "slack-token", "kind": "slack-token",
     "regex": "\\b(xox[abposre]-[A-Za-z0-9-]{10,})\\b"},
    {"id": "slack-webhook", "kind": "slack-webhook",
     "regex": "https://hooks\\.slack\\.com/services/T[A-Za-z0-9_]+/B[A-Za-z0-9_]+/[A-Za-z0-9_]+"},
    {"id": "stripe-key", "kind": "stripe-key",
     "regex": "\\b([sr]k_(?:live|test)_[A-Za-z0-9]{20,})\\b"},
    {"id": "google-api-key", "kind": "google-api-key",
     "regex": "\\b(AIza[0-9A-Za-z_-]{35})\\b"},
    {"id": "anthropic-key", "kind": "anthropic-key",
     "regex": "\\b(sk-ant-[A-Za-z0-9_-]{20,})"},
    {"id": "openai-key", "kind": "openai-key",
     "regex": "\\b(sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,})"},
    {"id": "npm-token", "kind": "npm-token",
     "regex": "\\b(npm_[A-Za-z0-9]{36})\\b"},
    {"id": "pypi-token", "kind": "pypi-token",
     "regex": "\\b(pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{50,})"},
    {"id": "huggingface-token", "kind": "huggingface-token",
     "regex": "\\b(hf_[A-Za-z0-9]{30,})\\b"},
    {"id": "supabase-secret", "kind": "supabase-key",
     "regex": "\\b(sb_secret_[A-Za-z0-9_-]{20,})"},
    {"id": "hashicorp-vault-token", "kind": "vault-token",
     "regex": "\\b(hv[sb]\\.[A-Za-z0-9_-]{24,})"},
    {"id": "azure-storage-key", "kind": "azure-storage-key",
     "regex": "AccountKey=(?P<v>[A-Za-z0-9+/=]{80,})", "group": "v", "flags": "i"},
    {"id": "azure-ad-client-secret", "kind": "azure-client-secret",
     "regex": "\\b([A-Za-z0-9_~.-]{3}8Q~[A-Za-z0-9_~.-]{31,34})\\b"},
    {"id": "sendgrid-key", "kind": "sendgrid-key",
     "regex": "\\b(SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43})\\b"},
    {"id": "telegram-bot-token", "kind": "telegram-token",
     "regex": "\\b(\\d{8,10}:AA[A-Za-z0-9_-]{33})\\b"},
    {"id": "digitalocean-token", "kind": "digitalocean-token",
     "regex": "\\b(do[pr]_v1_[a-f0-9]{64})\\b"},
    {"id": "mailgun-key", "kind": "mailgun-key",
     "regex": "\\b(key-[0-9a-f]{32})\\b"},
    {"id": "age-secret-key", "kind": "age-key",
     "regex": "\\b(AGE-SECRET-KEY-1[A-Z0-9]{58})\\b"},
    {"id": "jwt", "kind": "jwt",
     "regex": "\\b(eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})"},
    {"id": "private-key-block", "kind": "private-key",
     "regex": "-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?-----END (?:[A-Z ]+ )?PRIVATE KEY(?: BLOCK)?-----"},
    {"id": "putty-private-key", "kind": "private-key",
     "regex": "Private-Lines: \\d+\\n(?:[A-Za-z0-9+/=]+\\n)+"},
    {"id": "http-bearer", "kind": "bearer-token",
     "regex": "\\bBearer\\s+(?P<v>[A-Za-z0-9._~+/=-]{16,})", "group": "v", "flags": "i"},
    {"id": "http-basic", "kind": "basic-auth",
     "regex": "\\bBasic\\s+(?P<v>[A-Za-z0-9+/=]{16,})", "group": "v"},
    {"id": "docker-config-auth", "kind": "basic-auth",
     "regex": "\"auth\"\\s*:\\s*\"(?P<v>[A-Za-z0-9+/=]{8,})\"", "group": "v"},
    {"id": "url-credentials", "kind": "url-password",
     "regex": "://[^/\\s:@]*:(?P<v>[^/\\s@]{3,})@", "group": "v"},
    {"id": "cli-password-flag", "kind": "cli-password",
     "regex": "(?:^|\\s)--?(?:password|passwd|token|api[-_]?key|secret|client[-_]?secret|access[-_]?key|secret[-_]?key)(?:=|\\s+)(?P<v>[^\\s\"'`]{4,})", "group": "v", "flags": "im"},
    {"id": "generic-assignment", "kind": "credential",
     "regex": "(?P<k>[A-Za-z0-9_.-]*(?:password|passwd|pwd|secret|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|auth[_-]?key|credential|client[_-]?secret)[A-Za-z0-9_.-]*)[\"']?\\s*(?:=>|[:=])\\s*[\"']?(?P<v>[^\\s\"',;&)\\]}>]{8,})",
     "group": "v", "flags": "i", "generic": true}
  ]
}
